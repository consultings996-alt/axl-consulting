{
  "name": "axl-web-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@unhead/vue": "^3.4.2",
    "nodemailer": "^10.3.1",
    "vue": "^3.5.45",
    "vue-router": "^5.0.2"
  }
}
